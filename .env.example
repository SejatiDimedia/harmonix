# ==============================================================================
# Harnessly Environment Configuration (Zero-Cost Baseline)
# ==============================================================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL 16 + pgvector via Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=harnessly_user
DB_PASSWORD=harnessly_pass
DB_NAME=harnessly_db
DB_SCHEMA=analytics
DATABASE_URL=postgresql+asyncpg://harnessly_user:harnessly_pass@localhost:5432/harnessly_db

# LLM Provider Configuration (Zero-Cost Options)
# Options for LLM_PROVIDER: "ollama", "gemini", "groq", "mock"
LLM_PROVIDER=ollama

# Option 1: Ollama (100% Offline & Free on local Mac)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Option 2: Google AI Studio (Free Tier, no credit card required)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option 3: Groq Cloud (Free Tier, ultra-fast inference)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Agent Harness Constraints
AGENT_MAX_STEPS=10
AGENT_STEP_TIMEOUT_SECONDS=30
AGENT_TOTAL_TIMEOUT_SECONDS=120
AGENT_MAX_TOKEN_BUDGET=15000

# SQL Guardrail Parameters
SQL_MAX_ROW_LIMIT=100
SQL_EXECUTION_TIMEOUT_SECONDS=10
