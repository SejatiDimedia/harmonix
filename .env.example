# ==============================================================================
# Harmonix Environment Configuration (Zero-Cost Baseline)
# ==============================================================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security & CORS (P0-3, P0-4)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
API_AUTH_KEY=
ADMIN_API_KEY=

# Database (PostgreSQL 16 + pgvector via Docker Compose)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=harmonix_user
DB_PASSWORD=harmonix_pass
DB_NAME=harmonix_db
DB_SCHEMA=analytics
DATABASE_URL=postgresql+asyncpg://harmonix_user:harmonix_pass@127.0.0.1:5433/harmonix_db

# LLM Provider Configuration (Zero-Cost Options)
# Options for LLM_PROVIDER: "ollama", "gemini", "groq", "openrouter", "9router", "mock"
LLM_PROVIDER=ollama

# Option 1: Ollama (100% Offline & Free on local Mac)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Option 2: Google AI Studio (Free Tier, no credit card required)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option 3: Groq Cloud (Free Tier, ultra-fast inference)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 4: OpenRouter (Free Tier Models: :free)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Option 5: 9Router (Smart Local AI Gateway on port 20128)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=sk-8abbefea34ddc0cc-npg38u-a6649356
NINEROUTER_MODEL=ag/gemini-3.8-flash

# Agent Harness Constraints
AGENT_MAX_STEPS=10
AGENT_STEP_TIMEOUT_SECONDS=30
AGENT_TOTAL_TIMEOUT_SECONDS=120
AGENT_MAX_TOKEN_BUDGET=200000

# SQL Guardrail Parameters
SQL_MAX_ROW_LIMIT=100
SQL_EXECUTION_TIMEOUT_SECONDS=10

# Observability & Tracing (OB-01: Langfuse Cloud Free Tier / Self-hosted)
# If empty, traces and metrics are saved to local PostgreSQL (analytics.agent_traces) at zero cost.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
